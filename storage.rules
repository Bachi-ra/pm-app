rules_version = '2';

// 添付ファイル(素材/資料/リンク集)用のCloud Storageセキュリティルール。
// Firestoreの firestore.rules と対になっており、権限判定のために
// FirestoreのmemberClaims/membersコレクションを参照する(firestore.get/exists)。
//
// firestore.rulesと同じく、権限モデルはあくまで簡易的なもの(身内の小規模チーム
// での利用を想定)。フォルダ単位(assets/references/links)での許可であり、
// Firestore側のように「投稿者本人のみ」までは絞り込んでいない。
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasClaim() {
      return firestore.exists(/databases/(default)/documents/memberClaims/$(request.auth.uid));
    }

    function claimedMemberId() {
      return firestore.get(/databases/(default)/documents/memberClaims/$(request.auth.uid)).data.memberId;
    }

    function isAdmin() {
      return hasClaim() &&
        firestore.get(/databases/(default)/documents/members/$(claimedMemberId())).data.isAdmin == true;
    }

    // 素材(assets)の添付ファイル: メンバー全員がアップロード可能(Firestore側の
    // assetsコレクションのルールと同じ)。deleteはrequest.resourceが無いため
    // create/updateとは条件を分けている。
    match /assets/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && hasClaim() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if signedIn() && hasClaim();
    }

    // 資料(references)の添付ファイル: メンバー全員がアップロード可能。
    match /references/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && hasClaim() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if signedIn() && hasClaim();
    }

    // リンク集(links)の添付ファイル: PMのみアップロード可能(Firestore側と同じ)。
    match /links/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
