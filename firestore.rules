rules_version = '2';

// Firebaseコンソール →「Firestore Database」→「ルール」タブに、この内容を貼り付けて
// 「公開」してください。
//
// 匿名認証(request.auth != null)だけでは「誰でも」を意味してしまい、
// 管理者権限の判定や本人確認ができません。そこで、匿名セッション(uid)を
// members ドキュメントに一度だけ紐付ける memberClaims コレクションを使って
// 「このセッションは誰か」をFirestore側で検証できるようにしています。
//
// 注意: EVERYONE_ROLE の値 '全員' は docs/js/utils.js の EVERYONE_ROLE 定数と
// 一致させてください(変更する場合は両方直してください)。
//
// デプロイ後の一度きりの移行について:
// このルールを初めて公開した直後は、まだ誰も memberClaims / meta/appInfo を
// 持っていないため、既存メンバーは一度「あなたの名前を選択」してログインし直す
// 必要があります(アプリが自動でmeta/appInfoを補完します)。この移行が完了する
// までの短い間、他の訪問者が管理者になりすませる隙が理論上あるため、
// ルール公開後はできるだけ早く、既存の管理者がログインし直してください。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasClaim() {
      return exists(/databases/$(database)/documents/memberClaims/$(request.auth.uid));
    }

    function claimedMemberId() {
      return get(/databases/$(database)/documents/memberClaims/$(request.auth.uid)).data.memberId;
    }

    function myMember() {
      return get(/databases/$(database)/documents/members/$(claimedMemberId())).data;
    }

    function isAdmin() {
      return signedIn() && hasClaim() && myMember().isAdmin == true;
    }

    // メンバーの役職一覧を返す。新形式のroles(配列)を優先し、旧形式の
    // role(単一文字列)しか無いメンバーはそれを1件配列として扱う
    // (docs/js/utils.js の memberRoles() と同じ考え方)。
    function memberRoleList(m) {
      return 'roles' in m ? m.roles : (('role' in m && m.role != '') ? [m.role] : []);
    }

    // 指定の役職(または「全員」)が自分の役職一覧に含まれるか。
    function hasAssignedRole(role) {
      return role == '全員' || role in memberRoleList(myMember());
    }

    // 指定タスクの担当役職が自分の役職(または「全員」)と一致するか。
    function isTaskOwner(taskId) {
      let t = get(/databases/$(database)/documents/tasks/$(taskId)).data;
      return signedIn() && hasClaim() && hasAssignedRole(t.assigneeRole);
    }

    // 最初の管理者登録(または、このルール公開後の一度きりの移行)が完了したかどうかの印。
    match /meta/appInfo {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['bootstrapped', 'adminCount'])
        && request.resource.data.bootstrapped == true;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 締切リマインド通知の設定。discordWebhookUrlはPMのみ変更可能。
    // lastDiscordNotifyDateは「今日はもう送った」という早い者勝ちの印で、
    // どのメンバーのブラウザが最初にダッシュボードを開いたかによって更新される。
    match /meta/notifications {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && hasClaim() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDiscordNotifyDate'])
      );
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if signedIn();

      // 通常は管理者のみ新規メンバーを作成できる。
      // 例外として、meta/appInfo がまだ存在しない(=誰も管理者として
      // 確定していない)間だけ、isAdmin:true での作成を許可する。
      allow create: if signedIn() && (
        isAdmin() ||
        (request.resource.data.isAdmin == true && !exists(/databases/$(database)/documents/meta/appInfo))
      );

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 匿名セッション(uid)と members ドキュメントの、一度きりの紐付け。
    // 「未紐付けの既存メンバーを自分だと申告する」行為であり、パスワードなしで
    // 名前を選ぶ今までの挙動と信頼モデルは同じだが、一度紐付けたら他人に
    // 成りすませなくなる分、安全になる。
    match /memberClaims/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['memberId'])
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId));

      // 紐付け先のメンバーが削除された場合の本人による再登録、
      // または管理者による強制リセットのみ許可する。
      allow delete: if signedIn() && (
        isAdmin() ||
        (uid == request.auth.uid && !exists(/databases/$(database)/documents/members/$(resource.data.memberId)))
      );
      allow update: if false;
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();

      // 担当役職が自分の役職(または「全員」)と一致するメンバーは、
      // 状態(status)と進捗(progress)のみ更新できる。それ以外は管理者のみ。
      // ただしdiscordNotifiedWeekBefore(1週間前通知の送信済みフラグ)だけは
      // signedInなら誰でも更新できる(claimTaskWeekBeforeNotificationのため)。
      allow update: if isAdmin() || (
        signedIn() && hasClaim() &&
        hasAssignedRole(resource.data.assigneeRole) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress'])
      ) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discordNotifiedWeekBefore'])
      );
    }

    match /taskComments/{id} {
      allow read: if signedIn();

      // 通常は投稿者本人のみ作成可能。管理者はバックアップ復元時に元の投稿者の
      // まま書き戻せるよう、authorMemberIdの一致チェックを免除される。
      allow create: if signedIn() && hasClaim()
        && (request.resource.data.authorMemberId == claimedMemberId() || isAdmin());

      // 投稿者本人は本文のみ編集可能。
      allow update: if signedIn() && hasClaim()
        && resource.data.authorMemberId == claimedMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);

      // 投稿者本人、または管理者が削除可能。
      allow delete: if signedIn() && hasClaim()
        && (resource.data.authorMemberId == claimedMemberId() || isAdmin());
    }

    match /versions/{id} {
      allow read: if signedIn();

      // 通常はタスク担当者本人のみ作成可能。管理者はバックアップ復元時に元の
      // 投稿者のまま書き戻せるよう、担当者チェック・createdBy一致チェックを免除される。
      allow create: if signedIn()
        && (isAdmin() || (isTaskOwner(request.resource.data.taskId) && request.resource.data.createdBy == claimedMemberId()));

      // PMまたはタスク担当者がステータスのみ変更できる。
      allow update: if signedIn()
        && (isAdmin() || isTaskOwner(resource.data.taskId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin();
    }

    match /milestones/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /memos/{id} {
      allow read: if signedIn();

      // 通常は投稿者本人のみ作成可能。管理者はバックアップ復元時に元の投稿者の
      // まま書き戻せるよう、authorIdの一致チェックを免除される。
      allow create: if signedIn() && hasClaim()
        && (request.resource.data.authorId == claimedMemberId() || isAdmin());

      // 投稿者本人は本文のみ編集可能。それとは別に、既読管理のため
      // signedInなら誰でもreadByフィールドだけは更新できる。
      allow update: if (signedIn() && hasClaim()
        && resource.data.authorId == claimedMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );

      // 投稿者本人、または管理者が削除可能。
      allow delete: if signedIn() && hasClaim()
        && (resource.data.authorId == claimedMemberId() || isAdmin());
    }

    match /links/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 素材・権利管理表: 追加・編集はメンバー全員可、削除はPMのみ。
    match /assets/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && hasClaim();
      allow update: if signedIn() && hasClaim();
      allow delete: if isAdmin();
    }

    // バーンダウンチャート用の日次スナップショット。日付がドキュメントIDなので
    // 過去の日付は上書きされない(その日を最後に開いたクライアントの値になる)。
    match /progressSnapshots/{date} {
      allow read: if signedIn();
      allow write: if signedIn() && hasClaim();
    }

    // 共有PC/レンダーキュー管理: 誰でも閲覧・新規登録可。
    // ステータス/メモ/終了予定の変更と削除は登録者本人またはPMのみ。
    match /renderJobs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && hasClaim()
        && request.resource.data.memberId == claimedMemberId();
      allow update: if signedIn() && hasClaim()
        && (resource.data.memberId == claimedMemberId() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'estimatedEndAt']);
      allow delete: if signedIn() && hasClaim()
        && (resource.data.memberId == claimedMemberId() || isAdmin());
    }

    match /references/{id} {
      allow read: if signedIn();

      // 通常は投稿者本人のみ作成可能。管理者はバックアップ復元時に元の投稿者の
      // まま書き戻せるよう、uploadedByの一致チェックを免除される。
      allow create: if signedIn() && hasClaim()
        && (request.resource.data.uploadedBy == claimedMemberId() || isAdmin());

      // 投稿者本人のみ編集可能(投稿者自体の付け替えは不可)。
      allow update: if signedIn() && hasClaim()
        && resource.data.uploadedBy == claimedMemberId()
        && request.resource.data.uploadedBy == resource.data.uploadedBy;

      // 投稿者本人、または管理者が削除可能。
      allow delete: if signedIn() && hasClaim()
        && (resource.data.uploadedBy == claimedMemberId() || isAdmin());
    }
  }
}
